# Public address of the live website (no trailing slash), e.g. https://mehendibytrisha.in
# Used for the canonical URL, social-sharing tags, sitemap.xml and robots.txt.
#
# Leave empty until the domain is decided: on Netlify the build then uses the
# site's own Netlify address automatically. Set this once the real domain is live.
VITE_SITE_URL=
